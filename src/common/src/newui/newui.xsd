<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    targetNamespace="https://schema.yourdomain.com/ui"
    xmlns:ui="https://schema.yourdomain.com/ui"
    elementFormDefault="qualified"
>
    <!-- Attributes -->
    <xs:attribute name="weight" type="xs:float" default="1.0" />
    <xs:attribute name="spacing" type="xs:float" />
    <xs:attribute name="offset" type="xs:float" />

    <!-- Base Types -->
    <xs:complexType name="ContainerType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="Row" type="ui:RowType" />
            <xs:element name="Column" type="ui:ColumnType" />
            <xs:element name="Child" type="ui:ChildType" />
            <xs:element name="Include" type="ui:IncludeType" />
            <xs:element name="Text" type="ui:TextType" />
            <xs:element name="Button" type="ui:ButtonType" />
            <xs:element name="Selectable" type="ui:SelectableType" />
            <xs:element name="CollapsingHeader" type="ui:CollapsingHeaderType" />
        </xs:choice>
        <xs:attribute ref="ui:weight" />
    </xs:complexType>

    <!-- Layout -->
    <!-- Note: Deprecate root! -->
    <xs:element name="Root" type="ui:ContainerType" />

    <xs:complexType name="RowType">
        <xs:complexContent>
            <xs:extension base="ui:ContainerType">
                <xs:attribute ref="ui:spacing" />
                <xs:attribute ref="ui:offset" />
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="ColumnType">
        <xs:complexContent>
            <xs:extension base="ui:ContainerType">
                <xs:attribute ref="ui:spacing" />
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="ChildType">
        <xs:complexContent>
            <xs:extension base="ui:ContainerType">
                <xs:attribute name="id" type="xs:string" />
                <xs:attribute name="size" type="xs:string" default="0,0" />
                <xs:attribute name="flags" type="xs:integer" default="0" />
                <xs:attribute name="windowflags" type="xs:integer" default="0" />
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="CollapsingHeaderType">
        <xs:complexContent>
            <xs:extension base="ui:ContainerType">
                <xs:attribute name="label" type="xs:string" use="required" />
                <xs:attribute name="flags" type="xs:integer" default="0" />
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <!-- Content -->
    <xs:complexType name="IncludeType">
        <xs:attribute name="source" type="xs:string" use="required" />
        <xs:attribute ref="ui:weight" />
    </xs:complexType>

    <xs:complexType name="TextType">
        <xs:attribute name="content" type="xs:string" use="required" />
        <xs:attribute ref="ui:weight" />
    </xs:complexType>

    <!-- Controls -->
    <xs:complexType name="ButtonType">
        <xs:attribute name="label" type="xs:string" use="required" />
        <xs:attribute name="onclick" type="xs:string" />
        <xs:attribute name="size" type="xs:string" />
        <xs:attribute name="flags" type="xs:integer" default="0" />
        <xs:attribute name="enabled" type="xs:boolean" default="true" />
        <xs:attribute ref="ui:weight" />
    </xs:complexType>

    <xs:complexType name="SelectableType">
        <xs:attribute name="key" type="xs:string" use="required" />
        <xs:attribute name="label" type="xs:string" use="required" />
        <xs:attribute name="value" type="xs:string" />
        <xs:attribute name="onclick" type="xs:string" />
        <xs:attribute name="size" type="xs:string" />
        <xs:attribute name="flags" type="xs:integer" default="0" />
        <xs:attribute name="enabled" type="xs:boolean" default="true" />
        <xs:attribute ref="ui:weight" />
    </xs:complexType>
</xs:schema>
