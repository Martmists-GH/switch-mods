<?xml version="1.0" encoding="UTF-8" ?>
<Root xmlns="https://schema.yourdomain.com/ui"
      xmlns:custom="https://schema.yourdomain.com/pokemon_za/debug_tools"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="https://schema.yourdomain.com/ui newui.xsd">
  <Window label="{{ MODULE_NAME }} - By Martmists" position="50,50" size="400,450" flags="1056">
    <MenuBar>
      <Menu label="Windows">
        <MenuItem label="Performance" key="win_performance" />
        <MenuItem label="Party Inspector" key="win_party" />
        <MenuItem label="Quest Inspector" key="win_quest" />
      </Menu>
    </MenuBar>

    <Text content="Press ZL+R to toggle all menus. Hold Y to move or resize." />
    <Text content="Early access on patreon.com/martmists" />

    <Button label="Reload" onclick="reload" />

    <Spacing/>

    <CollapsingHeader label="Money">
      <Row>
        <Text content="Money" weight="1" />
        <Text contentscript="API:getMoney()" weight="1" />
        <Group weight="1">
          <Button label="+1000" onclick="API:addMoney( 1000)" />
          <Button label="-1000" onclick="API:addMoney(-1000)" />
        </Group>
        <Group weight="1">
          <Button label="+10000" onclick="API:addMoney( 10000)" />
          <Button label="-10000" onclick="API:addMoney(-10000)" />
        </Group>
        <Group weight="1">
          <Button label="+100000" onclick="API:addMoney( 100000)" />
          <Button label="-100000" onclick="API:addMoney(-100000)" />
        </Group>
      </Row>

      <Row>
        <Text content="Medals" weight="1" />
        <Text contentscript="API:getMedals()" weight="1" />
        <Group weight="1">
          <Button label="+100" onclick="API:addMedals( 100)" />
          <Button label="-100" onclick="API:addMedals(-100)" />
        </Group>
        <Group weight="1">
          <Button label="+1000" onclick="API:addMedals( 1000)" />
          <Button label="-1000" onclick="API:addMedals(-1000)" />
        </Group>
        <Group weight="1" />
      </Row>

      <Row>
        <Text content="Tickets" weight="1" />
        <Text contentscript="API:getTickets()" weight="1" />
        <Group weight="1">
          <Button label="+100" onclick="API:addTickets( 100)" />
          <Button label="-100" onclick="API:addTickets(-100)" />
        </Group>
        <Group weight="1">
          <Button label="+1000" onclick="API:addTickets( 1000)" />
          <Button label="-1000" onclick="API:addTickets(-1000)" />
        </Group>
        <Group weight="1">
          <Button label="+10000" onclick="API:addTickets( 10000)" />
          <Button label="-10000" onclick="API:addTickets(-10000)" />
        </Group>
      </Row>
    </CollapsingHeader>

    <CollapsingHeader label="Battle">
      <Checkbox label="100% Capture Rate" key="alwaysCapture" onchange="ffi.hook_setIsMustCapture(event.after)" />
      <Checkbox label="Enable EXP Share" key="expShareActive" onchange="ffi.hook_setIsExpShareOn(event.after)" default="true" />
      <Row>
        <SliderInt label="EXP Multiplier" key="expMultiplier" max="30" default="1" onchange="ffi.hook_setExpMultiplier(event.after)" />
        <Checkbox label="Invert (x2 -> x0.5)" key="invertExpGain" onchange="ffi.hook_setExpMultiplierInvert(event.after)" />
      </Row>
      <Checkbox label="Always Max Mega Energy" key="alwaysMaxEnergy" onchange="ffi.hook_setAlwaysMaxEnergy(event.after)" />
      <Checkbox label="Disable move cooldowns" key="alwaysMovesActive" onchange="ffi.hook_setMovesAlwaysActive(event.after)" />
    </CollapsingHeader>

    <CollapsingHeader label="Encounter Editor">
      <Checkbox label="100% Shiny Rate" key="encount.forceShiny" />
      <SliderInt label="Shiny Rate Multiplier" key="encount.shinyRateMultiplier" max="60" default="1" enabled="{{ default(encount.forceShiny, false) == false }}" />
      <Checkbox label="100% Alpha Rate" key="encount.forceAlpha" />
      <Checkbox label="Force Change Encounter" key="encount.forceChange" default="false" />
      <Include source="{{ ROM_MOUNT }}:/ui/part/poke_editor.xml" context='{"editor_type": "encount", "editor_extra_settings": false}' />
      <Callback onframe="API:saveEncounterData(context.encount)" />
    </CollapsingHeader>

    <CollapsingHeader label="Party">
      <InputInt label="Party Index" key="party.selectedIndex" max="5" />
      <Checkbox label="Enable" key="party.forceChange" />
      <Callback onframe="API:loadPartyData(context['party'])" />
      {% if default(party.isBadEgg, false) %}
      <Row>
        <Text content="Bad Egg detected!" />
        <Button label="Fix" onclick="API:fixPartyData(context['party'])" />
      </Row>
      {% endif %}
      <Include source="{{ ROM_MOUNT }}:/ui/part/poke_editor.xml" context='{"editor_type": "party", "editor_extra_settings": true}' />
      <Callback onframe="API:savePartyData(context['party'])" />
    </CollapsingHeader>

    <CollapsingHeader label="Bag">
      {% if GAME_VERSION == '2.0.0' or  GAME_VERSION == '2.0.1' or  GAME_VERSION == '2.0.2' %}
        <InputInt label="Item ID" key="bag_item_id" min="1" default="1" max="2684" />
      {% else %}
        <InputInt label="Item ID" key="bag_item_id" min="1" default="1" max="2634" />
      {% endif %}
      <Row>
        <Text contentscript="API:getInternalItemName(context.bag_item_id or 1)" />
        <Text contentscript="API:getItemName(context.bag_item_id or 1)" />
      </Row>
      <Row>
        <Button label="Add 1"   onclick="ffi._ZN2ik5event24IkkakuEventScriptCommand7AddItemEjj(context.bag_item_id or 1,   1)" />
        <Button label="Add 10"  onclick="ffi._ZN2ik5event24IkkakuEventScriptCommand7AddItemEjj(context.bag_item_id or 1,  10)" />
        <Button label="Add 100" onclick="ffi._ZN2ik5event24IkkakuEventScriptCommand7AddItemEjj(context.bag_item_id or 1, 100)" />
      </Row>
      <Row>
        <Button label="Remove 1"   onclick="ffi._ZN2ik5event24IkkakuEventScriptCommand7AddItemEjj(context.bag_item_id or 1,   -1)" />
        <Button label="Remove 10"  onclick="ffi._ZN2ik5event24IkkakuEventScriptCommand7AddItemEjj(context.bag_item_id or 1,  -10)" />
        <Button label="Remove 100" onclick="ffi._ZN2ik5event24IkkakuEventScriptCommand7AddItemEjj(context.bag_item_id or 1, -100)" />
      </Row>
    </CollapsingHeader>

    <CollapsingHeader label="Weather">
      <Button label="Reset" onclick="ffi._ZN2ik24EventSystemCallFunctions17ReleaseFixWeatherEv()" />
      {% for weather in ["Sunny", "Cloudy", "Rain", "Storm", "Snow", "Snowstorm", "Diamonddust", "Sandstorm", "Mist"] %}
        {% if loop.index % 3 == 0 %}<Row>{% endif %}
        <Button label="{{ weather }}" onclick="ffi.hook_setWeather('{{ lower(weather) }}')" />
        {% if loop.index % 3 == 2 %}</Row>{% endif %}
      {% endfor %}
    </CollapsingHeader>
  </Window>

  <Window label="Performance" open="win_performance" sticky="true" position="800, 50" size="450, 280">
    <SeparatorText content="FPS" />
    <custom:PerformanceFPS key="perfWindow" />
    <SeparatorText content="Memory" />
    <custom:PerformanceMemory />
  </Window>

  <Window label="Party Inspector" open="win_party">
    <InputInt label="Party Index" key="party_details.selectedIndex" max="5" />
    <Callback onframe="API:loadPartyData(context['party_details'])" />
    <Text content="WIP" />
  </Window>

  <Window label="Quest Inspector" open="win_quest">
    <Text content="WIP" />
  </Window>
</Root>
